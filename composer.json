{
    "name": "tousleshoraires/contact-bundle",
    "type": "symfony-bundle",
    "description": "Symfony TLHContactBundle",
    "keywords": ["contact form"],
    "homepage": "https://github.com/tousleshoraires/",
    "license": "MIT",
    "authors": [
        {
            "name": "Julien Devergnies",
            "email": "julien@tousleshoraires.fr"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": ">=6.0",
        "symfony/class-loader": "*",
        "symfony/framework-bundle": ">=5.0",
        "doctrine/orm": "^2.3|^3.0",
        "symfony/form": ">=5.0",
        "symfony/mailer": ">=5.0",
        "symfony/validator": ">=5.0",
        "twig/twig": "^1.0|^2.0"
    },
    "conflict": {},
    "suggest": {},
    "autoload": {
        "psr-4": { "TLH\\ContactBundle\\": "" },
        "exclude-from-classmap": ["Tests/"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "Tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "support": {
        "docs": "http://www.tousleshoraires.com"
    }
}
